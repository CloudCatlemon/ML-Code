//@version=5
// 多項式通道 5分K 多空雙向版
// 理念 (與 0921 系列相同)：
//   通道有延遲 → 價格由低點反轉時先收盤突破上軌 → 做多；由高點反轉時先收盤跌破下軌 → 做空
//   1 分K 最近 30 分鐘帶量上漲收上軌、帶量下跌收下軌 → 加快進場與出場
// 5 分K 新增 (參考目前常用的當沖通道/量能工具)：
//   (1) 中軌可切換「二階多項式」或「Nadaraya-Watson 核迴歸 (不重繪端點版)」
//   (2) 日/夜盤各自錨定的 VWAP 作為多空方向過濾 (多單須在 VWAP 上、空單須在 VWAP 下)
//   (3) 可選 TTM Squeeze 過濾：只做「剛經歷波動壓縮」後的突破
//   (4) 開盤前 N 分鐘不進場 (5 分K 開盤前幾根雜訊最大)
//   (5) 多空反手：持多時出現空單訊號直接反手，反之亦然
// 預設參數為起始值，未經回測，請以策略測試器調參
strategy("多項式通道 5分K 多空 (VWAP+30分熱度+ATR風控)", overlay=true, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, calc_on_every_tick=true, commission_type=strategy.commission.cash_per_contract, commission_value=100, slippage=1)

// ==========================================
// 1. 交易方向
// ==========================================
trade_dir = input.string("雙向", title="交易方向", options=["雙向", "只做多", "只做空"], group="【交易方向】")
allow_long  = trade_dir != "只做空"
allow_short = trade_dir != "只做多"

// ==========================================
// 2. 通道參數
// ==========================================
midline_type     = input.string("多項式", title="中軌類型", options=["多項式", "Nadaraya-Watson"], group="【通道參數】")
poly_len         = input.int(120, title="多項式中軌長度", minval=3, group="【通道參數】")
nw_len           = input.int(120, title="NW 回看長度", minval=10, maxval=300, group="【通道參數】")
nw_bandwidth     = input.float(16.0, title="NW 頻寬 (越大越平滑、延遲越大)", minval=1.0, step=1.0, group="【通道參數】")
smooth_len       = input.int(8, title="🌟 中軌慣性平滑度", minval=1, maxval=20, group="【通道參數】")
adx_len          = input.int(15, title="ADX 長度", minval=1, group="【通道參數】")
atr_len          = input.int(14, title="ATR 長度", minval=1, group="【通道參數】")
base_mult        = input.float(1.5, title="日盤基準通道寬度乘數", step=0.1, group="【通道參數】")
night_ratio      = input.float(1.0, title="夜盤基準寬度比例 (>1放寬, <1縮小)", step=0.1, minval=0.1, maxval=3.0, group="【通道參數】")

// ==========================================
// 3. 帶量收縮 (30 分鐘滾動熱度，日夜盤分立)
// ==========================================
enable_contract       = input.bool(true, title="🔥 啟用帶量收縮通道機制", group="【1分K 多空熱度收縮】")
directional_contract  = input.bool(true, title="🧭 方向性收縮 (多熱只收上軌、空熱只收下軌)", group="【1分K 多空熱度收縮】")
heat_window_min       = input.int(30, title="熱度統計視窗 (分鐘)", minval=5, maxval=240, group="【1分K 多空熱度收縮】")
day_contract_weight   = input.float(0.8, title="☀️ 日盤熱度收縮強度", minval=0.0, maxval=2.0, step=0.05, group="【1分K 多空熱度收縮】")
night_contract_weight = input.float(0.6, title="🌙 夜盤熱度收縮強度", minval=0.0, maxval=2.0, step=0.05, group="【1分K 多空熱度收縮】")
morale_smooth         = input.int(3, title="🌟 士氣平滑度 (5分K圖建議 2~4)", minval=1, maxval=15, group="【1分K 多空熱度收縮】")
min_band_ratio        = input.float(0.40, title="極限收縮下限比例 (防軌道過窄)", minval=0.1, maxval=0.8, step=0.05, group="【1分K 多空熱度收縮】")

enable_vol_gate       = input.bool(true, title="📊 需「帶量」才收縮 (量能高於基準)", group="【帶量判定】")
vol_base_len          = input.int(600, title="量能基準長度 (K棒數，日夜盤各自計算)", minval=20, group="【帶量判定】")
vol_full_ratio        = input.float(1.5, title="滿額收縮所需量比 (30分均量 / 基準)", minval=0.5, maxval=5.0, step=0.1, group="【帶量判定】")

// ==========================================
// 4. 進場過濾
// ==========================================
use_vwap_filter   = input.bool(true, title="✅ VWAP 方向過濾 (多在上、空在下)", group="【進場過濾】")
use_heat_confirm  = input.bool(true, title="✅ 進場需同向熱度確認", group="【進場過濾】")
entry_bias_min    = input.float(0.10, title="進場最低 30 分淨量比 (多≥此值、空≤負此值)", minval=0.0, maxval=1.0, step=0.05, group="【進場過濾】")
use_chase_filter  = input.bool(true, title="✅ 防追價 (收盤離軌道過遠不進)", group="【進場過濾】")
chase_atr_mult    = input.float(1.0, title="最大追價距離 (ATR 倍數)", minval=0.1, step=0.1, group="【進場過濾】")
use_squeeze       = input.bool(false, title="✅ Squeeze 過濾 (近期須有波動壓縮)", group="【進場過濾】")
squeeze_len       = input.int(20, title="Squeeze 長度 (BB/KC)", minval=5, group="【進場過濾】")
squeeze_kc_mult   = input.float(1.5, title="Squeeze KC 倍數", minval=0.5, step=0.1, group="【進場過濾】")
squeeze_lookback  = input.int(12, title="壓縮需發生在最近幾根內", minval=1, group="【進場過濾】")
open_skip_min     = input.int(15, title="開盤後幾分鐘不進場 (日盤 08:45、夜盤 15:00)", minval=0, maxval=60, step=5, group="【進場過濾】")
cooldown_bars     = input.int(3, title="出場後冷卻 K 棒數 (0=不冷卻，反手不受限)", minval=0, group="【進場過濾】")

// ==========================================
// 5. 出場與風控
// ==========================================
enable_tp_trail   = input.bool(true, title="💰 啟用動態保利 (極值回吐鎖利)", group="【保利設定】")
tp_use_atr        = input.bool(true, title="保利門檻改用 ATR 倍數 (關閉則用點數)", group="【保利設定】")
tp_start_atr      = input.float(5.0, title="啟動保利所需浮盈 (進場時 ATR 倍數)", minval=0.5, step=0.5, group="【保利設定】")
tp_start_points   = input.float(150.0, title="啟動保利所需浮盈點數", minval=10.0, step=10.0, group="【保利設定】")
tp_pullback_pct   = input.float(40.0, title="最高浮盈回吐平倉比例 (%)", minval=5.0, maxval=80.0, step=5.0, group="【保利設定】")

enable_hard_stop  = input.bool(true, title="🛑 啟用 ATR 硬停損 (盤中觸價)", group="【停損設定】")
sl_atr_mult       = input.float(2.5, title="停損距離 (進場時 ATR 倍數)", minval=0.5, step=0.1, group="【停損設定】")
sl_max_points     = input.float(0.0, title="停損點數上限 (0=不設上限)", minval=0.0, step=10.0, group="【停損設定】")
enable_breakeven  = input.bool(true, title="🔒 啟用保本移損", group="【停損設定】")
be_atr_mult       = input.float(1.5, title="浮盈達幾倍 ATR 後移至保本", minval=0.1, step=0.1, group="【停損設定】")
be_offset_points  = input.float(5.0, title="保本價加碼點數 (覆蓋手續費)", minval=0.0, step=1.0, group="【停損設定】")

enable_gap_exit   = input.bool(true, title="🚨 早盤跳空保護 (多單跳空開低 / 空單跳空開高)", group="早盤跳空保護")
gap_pct           = input.float(2.0, title="跳空門檻 (%)", minval=0.1, step=0.1, group="早盤跳空保護")
flat_at_close     = input.bool(false, title="⏰ 每盤收盤前平倉 (13:45 / 05:00 前最後一根)", group="早盤跳空保護")

// --- 時段過濾設定 ---
filter_1500_1800  = input.bool(false, title="🚫 限制時段：15:00-18:00 不進場", group="時段過濾")
filter_0000_0400  = input.bool(false, title="🚫 限制時段 0：00:00-04:00 不進場", group="時段過濾")
filter_0400_0430  = input.bool(true, title="🚫 限制時段 1：04:00-04:30 不進場", group="時段過濾")
filter_0430_0500  = input.bool(true, title="🚫 限制時段 2：04:30-05:00 不進場", group="時段過濾")

show_vwap         = input.bool(true, title="顯示 VWAP", group="顯示")
show_heat_bg      = input.bool(false, title="顯示熱度背景色", group="顯示")

// ==========================================
// 6. 時段判定 (以 Asia/Taipei 為準)
// ==========================================
is_day_session  = not na(time(timeframe.period, "0845-1345", "Asia/Taipei"))
session_mult    = is_day_session ? 1.0 : night_ratio

current_hour    = hour(time, "Asia/Taipei")
current_minute  = minute(time, "Asia/Taipei")
time_in_minutes = current_hour * 60 + current_minute
close_minutes   = hour(time_close, "Asia/Taipei") * 60 + minute(time_close, "Asia/Taipei")

in_no_trade_afternoon = filter_1500_1800 and (time_in_minutes >= 900 and time_in_minutes < 1080)
in_no_trade_0         = filter_0000_0400 and (time_in_minutes >= 0 and time_in_minutes < 240)
in_no_trade_1         = filter_0400_0430 and (time_in_minutes >= 240 and time_in_minutes < 270)
in_no_trade_2         = filter_0430_0500 and (time_in_minutes >= 270 and time_in_minutes < 300)
in_open_skip          = (time_in_minutes >= 525 and time_in_minutes < 525 + open_skip_min) or (time_in_minutes >= 900 and time_in_minutes < 900 + open_skip_min)
is_last_bar_of_sess   = close_minutes == 825 or close_minutes == 300

is_trading_allowed    = not in_no_trade_afternoon and not in_no_trade_0 and not in_no_trade_1 and not in_no_trade_2 and not in_open_skip and not (flat_at_close and is_last_bar_of_sess)
is_morning_open_bar   = (current_hour == 8 and current_minute == 45)

// ==========================================
// 7. 中軌：二階多項式 / Nadaraya-Watson
// ==========================================
f_poly2(src, len) =>
    float s0 = len
    float s1 = 0.0, float s2 = 0.0, float s3 = 0.0, float s4 = 0.0
    for i = 0 to len - 1
        s1 += i
        s2 += math.pow(i, 2)
        s3 += math.pow(i, 3)
        s4 += math.pow(i, 4)

    float t0 = 0.0, float t1 = 0.0, float t2 = 0.0
    for i = 0 to len - 1
        y = src[i]
        t0 += y
        t1 += i * y
        t2 += math.pow(i, 2) * y

    float d = s0 * (s2 * s4 - s3 * s3) - s1 * (s1 * s4 - s2 * s3) + s2 * (s1 * s3 - s2 * s2)
    float a = (t0 * (s2 * s4 - s3 * s3) - t1 * (s1 * s4 - s2 * s3) + t2 * (s1 * s3 - s2 * s2)) / d
    a

// 只用過去資料的高斯核加權 (端點估計)，不會重繪
f_nw(src, len, h) =>
    float sw = 0.0
    float sv = 0.0
    for i = 0 to len - 1
        w = math.exp(-(i * i) / (2.0 * h * h))
        sv += src[i] * w
        sw += w
    sv / sw

raw_poly    = f_poly2(close, poly_len)
raw_nw      = f_nw(close, nw_len, nw_bandwidth)
raw_midline = midline_type == "多項式" ? raw_poly : raw_nw
midline     = ta.ema(raw_midline, smooth_len)

// ==========================================
// 8. 基礎動態通道半徑
// ==========================================
[diplus, diminus, adx] = ta.dmi(adx_len, adx_len)
atr = ta.atr(atr_len)

dynamic_mult  = base_mult * ((100 - adx) / 50) * session_mult
base_distance = atr * dynamic_mult

// ==========================================
// 9. 帶量收縮核心：滾動 30 分鐘 1分K 多空熱度 (Volume Delta)
// ==========================================
[o_arr_1m, c_arr_1m, v_arr_1m] = request.security_lower_tf(syminfo.tickerid, "1", [open, close, volume])

tf_minutes   = timeframe.in_seconds(timeframe.period) / 60.0
float bull_vol_bar = 0.0
float bear_vol_bar = 0.0
n_1m     = array.size(c_arr_1m)
ib_start = tf_minutes > heat_window_min ? math.max(0, n_1m - heat_window_min) : 0
if n_1m > ib_start
    for i = ib_start to n_1m - 1
        c_i = array.get(c_arr_1m, i)
        o_i = array.get(o_arr_1m, i)
        v_i = array.get(v_arr_1m, i)
        if c_i > o_i
            bull_vol_bar += v_i
        else if c_i < o_i
            bear_vol_bar += v_i
        else
            bull_vol_bar += v_i * 0.5
            bear_vol_bar += v_i * 0.5

// 換盤 (日/夜盤切換或休市斷層) 時重置視窗
heat_bars      = math.max(1, math.round(heat_window_min / tf_minutes))
gap_ms         = math.max(30.0, 2.0 * tf_minutes) * 60000.0
new_session    = bar_index == 0 or is_day_session != is_day_session[1] or (time - time[1]) > gap_ms
bars_in_sess   = ta.barssince(new_session) + 1
heat_win       = math.max(1, math.min(heat_bars, nz(bars_in_sess, heat_bars)))

cum_bull       = ta.cum(bull_vol_bar)
cum_bear       = ta.cum(bear_vol_bar)
bull_win       = cum_bull - nz(cum_bull[heat_win])
bear_win       = cum_bear - nz(cum_bear[heat_win])
total_win      = bull_win + bear_win
net_bias_win   = total_win > 0 ? (bull_win - bear_win) / total_win : 0.0

// 帶量判定：每根 K 棒平均量 vs 日/夜盤各自基準
avg_vol_win = total_win / heat_win
var float day_vol_base   = na
var float night_vol_base = na
prev_base   = is_day_session ? day_vol_base : night_vol_base
vol_ratio   = na(prev_base) or prev_base <= 0 ? 1.0 : avg_vol_win / prev_base
base_alpha  = 2.0 / (vol_base_len + 1)
if total_win > 0
    if is_day_session
        day_vol_base   := na(day_vol_base) ? avg_vol_win : day_vol_base + base_alpha * (avg_vol_win - day_vol_base)
    else
        night_vol_base := na(night_vol_base) ? avg_vol_win : night_vol_base + base_alpha * (avg_vol_win - night_vol_base)

vol_factor = enable_vol_gate ? math.min(vol_ratio / vol_full_ratio, 1.0) : 1.0

bull_heat = ta.ema(math.max(net_bias_win, 0.0) * vol_factor, morale_smooth)
bear_heat = ta.ema(math.max(-net_bias_win, 0.0) * vol_factor, morale_smooth)

current_contract_weight = is_day_session ? day_contract_weight : night_contract_weight
upper_heat   = directional_contract ? bull_heat : bull_heat + bear_heat
lower_heat   = directional_contract ? bear_heat : bull_heat + bear_heat
upper_factor = enable_contract ? math.max(min_band_ratio, 1.0 - upper_heat * current_contract_weight) : 1.0
lower_factor = enable_contract ? math.max(min_band_ratio, 1.0 - lower_heat * current_contract_weight) : 1.0

upper_band = midline + (base_distance * upper_factor)
lower_band = midline - (base_distance * lower_factor)

// ==========================================
// 10. VWAP (日/夜盤各自錨定) 與 Squeeze
// ==========================================
session_vwap = ta.vwap(hlc3, new_session)

sq_bb_dev    = 2.0 * ta.stdev(close, squeeze_len)
sq_kc_range  = squeeze_kc_mult * ta.atr(squeeze_len)
in_squeeze   = sq_bb_dev < sq_kc_range
bars_since_sq = nz(ta.barssince(in_squeeze), squeeze_lookback + 1)
squeeze_ok   = not use_squeeze or bars_since_sq <= squeeze_lookback

// ==========================================
// 11. 動態保利 + 停損 (多空通用，皆只朝有利方向移動)
// ==========================================
pos_dir = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0

var float best_price    = na
var float tp_exit_price = na
var float entry_atr     = na
var int   last_dir      = 0

// 方向改變 (含反手) 時重置
if (pos_dir != last_dir)
    best_price    := na
    tp_exit_price := na
    last_dir      := pos_dir

float open_profit_max = na
if (pos_dir != 0)
    avg_px = strategy.position_avg_price
    best_price      := pos_dir > 0 ? math.max(nz(best_price, high), high) : math.min(nz(best_price, low), low)
    open_profit_max := pos_dir > 0 ? best_price - avg_px : avg_px - best_price

    if (enable_tp_trail)
        tp_threshold = tp_use_atr and not na(entry_atr) ? tp_start_atr * entry_atr : tp_start_points
        if (open_profit_max >= tp_threshold)
            calc_px = best_price - pos_dir * open_profit_max * (tp_pullback_pct / 100.0)
            tp_exit_price := na(tp_exit_price) ? calc_px : pos_dir > 0 ? math.max(tp_exit_price, calc_px) : math.min(tp_exit_price, calc_px)

f_sl_distance(a) =>
    d = sl_atr_mult * a
    sl_max_points > 0 ? math.min(d, sl_max_points) : d

float stop_price = na
if (pos_dir != 0 and not na(entry_atr))
    avg_px = strategy.position_avg_price
    if (enable_hard_stop)
        stop_price := avg_px - pos_dir * f_sl_distance(entry_atr)
    if (enable_breakeven and open_profit_max >= be_atr_mult * entry_atr)
        be_price   = avg_px + pos_dir * be_offset_points
        stop_price := na(stop_price) ? be_price : pos_dir > 0 ? math.max(stop_price, be_price) : math.min(stop_price, be_price)

// ==========================================
// 12. 訊號
// ==========================================
var int last_exit_bar = na
if (strategy.closedtrades > strategy.closedtrades[1])
    last_exit_bar := bar_index
cooldown_ok = cooldown_bars == 0 or na(last_exit_bar) or (bar_index - last_exit_bar) > cooldown_bars

cross_up   = ta.crossover(close, upper_band) and barstate.isconfirmed
cross_down = ta.crossunder(close, lower_band) and barstate.isconfirmed

// 1 分K 歷史有上限，沒有熱度資料的 K 棒不擋進場
long_heat_ok   = not use_heat_confirm or total_win <= 0 or net_bias_win >= entry_bias_min
short_heat_ok  = not use_heat_confirm or total_win <= 0 or net_bias_win <= -entry_bias_min
long_vwap_ok   = not use_vwap_filter or close > session_vwap
short_vwap_ok  = not use_vwap_filter or close < session_vwap
long_chase_ok  = not use_chase_filter or (close - upper_band) <= chase_atr_mult * atr
short_chase_ok = not use_chase_filter or (lower_band - close) <= chase_atr_mult * atr

long_signal  = allow_long  and cross_up   and long_heat_ok  and long_vwap_ok  and long_chase_ok  and squeeze_ok and is_trading_allowed
short_signal = allow_short and cross_down and short_heat_ok and short_vwap_ok and short_chase_ok and squeeze_ok and is_trading_allowed

exit_tp = not na(tp_exit_price) and barstate.isconfirmed and (pos_dir > 0 ? close <= tp_exit_price : close >= tp_exit_price)

gap_long  = pos_dir > 0 and open <= strategy.position_avg_price * (1.0 - gap_pct / 100.0)
gap_short = pos_dir < 0 and open >= strategy.position_avg_price * (1.0 + gap_pct / 100.0)
is_gap_exit = enable_gap_exit and is_morning_open_bar and (gap_long or gap_short)

// 最後一根收盤當下立即平倉 (若等下一根開盤成交，會落在下一盤的跳空後)
session_flat = flat_at_close and is_last_bar_of_sess and barstate.isconfirmed

// ==========================================
// 13. 訂單執行
// 出場優先順序：停損/保本 (盤中觸價) → 早盤跳空 → 收盤前平倉 → 反手 → 回吐保利 → 反向軌道
// ==========================================
if (pos_dir > 0 and not na(stop_price))
    strategy.exit("SL-L", "Long", stop=stop_price, comment="L-SL")
if (pos_dir < 0 and not na(stop_price))
    strategy.exit("SL-S", "Short", stop=stop_price, comment="S-SL")

if (pos_dir > 0)
    if (is_gap_exit)
        strategy.close("Long", comment="L-Gap", immediately=true)
    else if (session_flat)
        strategy.close("Long", comment="L-EOD", immediately=true)
    else if (short_signal)
        entry_atr := atr
        strategy.entry("Short", strategy.short, comment="Rev-S")
        if (enable_hard_stop)
            strategy.exit("SL-S", "Short", stop=close + f_sl_distance(atr), comment="S-SL")
    else if (exit_tp)
        strategy.close("Long", comment="L-TP")
    else if (cross_down)
        strategy.close("Long", comment="L-Band")
else if (pos_dir < 0)
    if (is_gap_exit)
        strategy.close("Short", comment="S-Gap", immediately=true)
    else if (session_flat)
        strategy.close("Short", comment="S-EOD", immediately=true)
    else if (long_signal)
        entry_atr := atr
        strategy.entry("Long", strategy.long, comment="Rev-L")
        if (enable_hard_stop)
            strategy.exit("SL-L", "Long", stop=close - f_sl_distance(atr), comment="L-SL")
    else if (exit_tp)
        strategy.close("Short", comment="S-TP")
    else if (cross_up)
        strategy.close("Short", comment="S-Band")
else if (cooldown_ok)
    if (long_signal)
        entry_atr := atr
        strategy.entry("Long", strategy.long, comment="Long")
        if (enable_hard_stop)
            strategy.exit("SL-L", "Long", stop=close - f_sl_distance(atr), comment="L-SL")
    else if (short_signal)
        entry_atr := atr
        strategy.entry("Short", strategy.short, comment="Short")
        if (enable_hard_stop)
            strategy.exit("SL-S", "Short", stop=close + f_sl_distance(atr), comment="S-SL")

// ==========================================
// 14. 繪圖
// ==========================================
plot(midline, color=is_day_session ? color.fuchsia : color.orange, title="中軌", linewidth=2)
p_upper = plot(upper_band, color=color.new(color.blue, 0), title="上軌 (多方帶量收縮)")
p_lower = plot(lower_band, color=color.new(color.blue, 0), title="下軌 (空方帶量收縮)")
fill(p_upper, p_lower, color=color.new(color.blue, 90), title="通道背景")
plot(show_vwap ? session_vwap : na, color=color.new(color.gray, 0), style=plot.style_linebr, linewidth=1, title="VWAP (日夜盤錨定)")

plot(pos_dir != 0 and not na(tp_exit_price) ? tp_exit_price : na, color=color.orange, style=plot.style_linebr, linewidth=2, title="動態保利線")
plot(pos_dir != 0 ? stop_price : na, color=color.red, style=plot.style_linebr, linewidth=1, title="停損/保本線")

bgcolor(show_heat_bg ? (nz(bull_heat) > nz(bear_heat) ? color.new(color.green, 100 - nz(bull_heat) * 40) : color.new(color.red, 100 - nz(bear_heat) * 40)) : na, title="熱度背景")
